+                cairo_rotate(cairoTarget, DEG2RAD(ls->parameter[LINE22_ROTATION]));
+                cairo_translate(cairoTarget, ls->parameter[LINE22_LOWER_LEFT_X], ls->parameter[LINE22_LOWER_LEFT_Y]);
