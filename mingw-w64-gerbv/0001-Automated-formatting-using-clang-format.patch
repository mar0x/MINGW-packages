+    gerbvProject->project = g_strdup(filename);
+    if (gerbvProject->project == NULL)
+        GERB_FATAL_ERROR("malloc gerbvProject->project failed in %s()", __FUNCTION__);
 } /* gerbv_open_project_from_filename */
 
