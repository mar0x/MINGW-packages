+    gtk_window_get_position(GTK_WINDOW(win), (gint*)xy, (gint*)(xy + 1));
+    var = g_variant_new_fixed_array(G_VARIANT_TYPE_INT32, xy, 2, sizeof(xy[0]));
+    g_settings_set_value(screen.settings, "analyze-window-position", var);
 }
