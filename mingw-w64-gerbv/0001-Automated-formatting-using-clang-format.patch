+                    ip->next   = new_instruction(); /* XXX Check return value */
+                    ip         = ip->next;
+                    ip->opcode = MATH_OP_POP;
+                }
+                MATH_OP_PUSH(GERBV_OPCODE_ADD);
+                comma = 1;
+                break;
+            case '-':
+                if (comma) {
+                    neg   = 1;
+                    comma = 0;
+                    break;
+                }
+                while ((!MATH_OP_EMPTY) && (math_op_prec(MATH_OP_TOP) >= math_op_prec(GERBV_OPCODE_SUB))) {
+                    ip->next   = new_instruction(); /* XXX Check return value */
+                    ip         = ip->next;
+                    ip->opcode = MATH_OP_POP;
+                }
+                MATH_OP_PUSH(GERBV_OPCODE_SUB);
+                break;
