+
+        red   = (unsigned char)(file->color.red * 255 / G_MAXUINT16);
+        green = (unsigned char)(file->color.green * 255 / G_MAXUINT16);
+        blue  = (unsigned char)(file->color.blue * 255 / G_MAXUINT16);
+        alpha = (unsigned char)(file->alpha * 255 / G_MAXUINT16);
