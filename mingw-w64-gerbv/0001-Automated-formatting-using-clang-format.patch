+    /* Start arc point */
+    x = cirseg->cp_x + cirseg->width * cos(ang1) / 2;
+    y = cirseg->cp_y + cirseg->width * sin(ang1) / 2;
+    gerber_update_min_and_max(bbox, x, y, apert_size_x, apert_size_x, apert_size_y, apert_size_y);
