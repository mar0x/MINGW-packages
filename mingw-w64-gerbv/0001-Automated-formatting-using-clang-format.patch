+    gerbv_fileinfo_t* file_info;
+
+    dprintf("Opening project = %s\n", (gchar*)filename);
+    list = read_project_file(filename);
+
+    if (!list) {
+        GERB_COMPILE_WARNING(_("Could not read \"%s\" (loaded %d)"), (gchar*)filename, gerbvProject->last_loaded);
+
+        return;
