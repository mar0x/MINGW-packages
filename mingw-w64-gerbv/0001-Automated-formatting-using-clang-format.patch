+    );
+    gdk_pixmap_unref(renderedPixmap);
+
+    // run the cairo (normal) render mode
+    i                      = 0;
+    start                  = time(NULL);
+    now                    = start;
+    renderInfo->renderType = GERBV_RENDER_TYPE_CAIRO_NORMAL;
+    while (now - 30 < start) {
