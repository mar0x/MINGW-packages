-draw_calc_pnp_mark_coords(struct gerbv_net *start_net,
-		double *label_x, double *label_y)
-{
-	double x, y;
-	struct gerbv_net *net = start_net;
-	const char *label = NULL;
-	
-	if (net && net->label)
-		label = net->label->str;
-
-	if (label == NULL)
-		return 0;
